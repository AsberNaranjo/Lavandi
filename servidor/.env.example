# Ejemplo de la configuración del servidor. Se copia a .env, que no se versiona (ADR-0012).
# Aquí no va ningún secreto: APP_KEY sale de php artisan key:generate, y las contraseñas, llaves y tokens se
# escriben solo en el .env de cada entorno.
# El nombre del producto y la dirección salen de APP_NAME y APP_URL; nunca se escriben en el código.

APP_NAME="{{MARCA}}"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Acceso (ADR-0018): el mínimo de caracteres de la contraseña y los intentos por minuto, por correo y por dirección,
# del inicio de sesión y de la petición del enlace de recuperación.
ACCESO_CONTRASENA_MINIMA=8
ACCESO_INTENTOS_POR_MINUTO=5

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL con PostGIS en Docker, en la máquina de desarrollo (ADR-0004).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nsv_lavanderia
DB_USERNAME=nsv
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Recuperación de la contraseña (ADR-0018): minutos que dura el enlace del correo.
RECUPERACION_VENCE_MINUTOS=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Fotos de las lavanderías (ADR-0006 y config/fotos.php). Sin FOTOS_DISCO: fotos_s3 en producción, el bucket privado
# de AWS_BUCKET o de FOTOS_BUCKET; fotos_local en los demás entornos. El peso máximo es provisional: lo fija Arthur.
# FOTOS_DISCO=fotos_local
# FOTOS_BUCKET=
FOTOS_TIPOS=jpg,jpeg,png,webp
FOTOS_PESO_MAXIMO_KB=5120
FOTOS_VIGENCIA_MINUTOS=60

VITE_APP_NAME="${APP_NAME}"

# Inicio de sesión con Google (ADR-0005 y ADR-0012). Los IDs de cliente OAuth de este entorno, separados por comas:
# el idToken que manda la app se acepta solo si su destinatario (aud) es uno de ellos. Van a nombre del cliente en
# producción. Sin ninguno, nadie entra con Google.
GOOGLE_CLIENTES_OAUTH=
# GOOGLE_DIRECCION_DE_LLAVES=https://www.googleapis.com/oauth2/v3/certs

# Geocodificación de las direcciones escritas con Google Geocoding (ADR-0009, decisión 4; ADR-0012). La llave de este
# entorno, a nombre del cliente en producción y restringida a la API de Geocoding. Sin ella, una dirección escrita no
# se puede guardar y la app ofrece marcarla en el mapa.
GOOGLE_GEOCODIFICACION_LLAVE=
# GOOGLE_GEOCODIFICACION_DIRECCION=https://maps.googleapis.com/maps/api/geocode/json

# Soporte (perfil-y-soporte): el número de WhatsApp Business de EL CLIENTE para el chat de la app, en formato
# internacional, país y número. Lo da el cliente (DD-082). Vacío, la app muestra el chat como no disponible.
SOPORTE_WHATSAPP=

# Avisos al celular con Firebase Cloud Messaging (ADR-0008 y ADR-0012): la ruta al archivo JSON de la cuenta de
# servicio del proyecto de Firebase del entorno, fuera del repositorio y fuera de public/. Va a nombre del cliente en
# producción. Vacía, ningún aviso sale: cada intento queda en la bitácora y el pedido sigue (DD-072).
FCM_CREDENCIALES=

# Panel de indicadores (indicadores-E21): cada cuánto se refrescan solas las cifras con la página abierta, como "30s" o
# "1500ms". El valor espera DD-116 y su ADR. Vacío, las cifras se actualizan al abrir o recargar la página.
INDICADORES_REFRESCO=

# Panel de indicadores (indicadores-E13): los dos cortes del semáforo del ranking de lavanderías, en estrellas de 1 a
# 5. Los da el cliente (DD-114). Vacíos, el ranking se muestra sin semáforo.
INDICADORES_SEMAFORO_CORTE_ALTO=
INDICADORES_SEMAFORO_CORTE_BAJO=
